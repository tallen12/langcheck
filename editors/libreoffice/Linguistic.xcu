<?xml version="1.0" encoding="UTF-8"?>
<!-- Registers langcheck as the grammar checker for English. -->
<oor:component-data oor:name="Linguistic" oor:package="org.openoffice.Office"
    xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <node oor:name="ServiceManager">
    <node oor:name="GrammarCheckers">
      <node oor:name="org.langcheck.libreoffice.Proofreader" oor:op="fuse">
        <prop oor:name="Locales" oor:type="oor:string-list">
          <value>en-US en-GB en-AU en-CA en-NZ</value>
        </prop>
      </node>
    </node>
    <node oor:name="GrammarCheckerList">
      <prop oor:name="en-US" oor:op="fuse" oor:type="oor:string-list">
        <value>org.langcheck.libreoffice.Proofreader</value>
      </prop>
      <prop oor:name="en-GB" oor:op="fuse" oor:type="oor:string-list">
        <value>org.langcheck.libreoffice.Proofreader</value>
      </prop>
      <prop oor:name="en-AU" oor:op="fuse" oor:type="oor:string-list">
        <value>org.langcheck.libreoffice.Proofreader</value>
      </prop>
      <prop oor:name="en-CA" oor:op="fuse" oor:type="oor:string-list">
        <value>org.langcheck.libreoffice.Proofreader</value>
      </prop>
      <prop oor:name="en-NZ" oor:op="fuse" oor:type="oor:string-list">
        <value>org.langcheck.libreoffice.Proofreader</value>
      </prop>
    </node>
  </node>
</oor:component-data>
